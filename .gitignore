# Создайте файл .gitignore
cat > .gitignore << 'EOF'
# Виртуальное окружение
venv/
env/
ENV/
.venv/

# Кэш Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Отчеты и временные файлы
*.txt
!requirements.txt
!flake8_report.txt
!mypy_report.txt
*_report.txt
*_test.txt

# Бинарные файлы
*.bin
*.exe
*.dll
*.so
*.dylib

# Логи
*.log
EOF